{
  "name": "matter-reader-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "matter-cli": "github:getmatterapp/matter-cli",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "cloudflare": {
    "bindings": {
      "MATTER_API_TOKEN": {
        "description": "Your Matter API token. Stored as a Worker secret."
      },
      "READ_ONLY": {
        "description": "Set to true to expose only the eight read tools; false also enables writes."
      }
    }
  }
}
